# ═══════════════════════════════════════════════════
#  潮汐基频桥 · 环境配置
#  复制为 .env 后填写。不要提交 .env 到版本库。
# ═══════════════════════════════════════════════════

# ── 桥对外监听（Operit / OMate 把 Base URL 指向这里）──
BRIDGE_PORT=18220
BRIDGE_HOST=0.0.0.0

# ── 桥的访问鉴权（Operit 端填这个 token）──
# 至少 24 字符。Operit 请求时带 Authorization: Bearer <此值>
BRIDGE_TOKEN=change-me-at-least-24-chars-long

# ── 上游：Lattice 网关 ──
UPSTREAM_BASE=http://127.0.0.1:18217
# Lattice 的 Gateway Key（原样透传，桥不解析）
UPSTREAM_TOKEN=在此填写-Lattice-Gateway-Key

# ── 判定器小模型 ──
# 当前用 DeepSeek（deepseek-flash 为推理型，需关思考链）
LLM_BASE=https://api.deepseek.com/v1
LLM_KEY=在此填写-DeepSeek-API-Key
LLM_MODEL=deepseek-flash
# 关闭思考链（仅推理型模型需要）。实测 reasoning_content 消失、token 从 66→5。
# 换回非推理模型（agnes-3.0-flash 等）时设为 0。
LLM_DISABLE_THINKING=true
# 单次最大输出 token。关思考链后 300 足够；若关闭该限制则建议 1500。
LLM_MAX_TOKENS=300

# 备用：agnes（免费档但限流严格，实测连续调用即 429）
# LLM_BASE=https://apihub.agnes-ai.com/v1
# LLM_KEY=在此填写-agnes-API-Key
# LLM_MODEL=agnes-3.0-flash
# LLM_DISABLE_THINKING=0

# 判定器限流（重要：免费额度很容易被打爆，实测连续 6 次即 429）
# 最小调用间隔：同一时段 N 秒内只分析一次（用户连发时只算最后一次）
LLM_MIN_INTERVAL_SECONDS=20
# 熔断冷却：遇到 429/5xx 后，M 分钟内不再调用判定器
LLM_BREAKER_SECONDS=300

# ── 状态与日志 ──
STATE_FILE=/root/cadence-bridge/data/state.json
LOG_FILE=/root/cadence-bridge/data/bridge.log

# ── 潮汐基频参数（旋钮）──
# 每 N 分钟 tick 一次（内置定时器，不用额外 crontab）
TICK_MINUTES=5
# connection 基础增长速率（每分钟）。她不在时"想念"累积得多快。
#   0.0007 = 原值：她消失后 4h10 才到 0.20 留意线
#   0.0025 = 提速档：约 1h30 到留意线（实测首个动作从 6h40 提前到 10 分钟）
CONNECTION_RATE=0.0025
# 兜底：判定器**没跑成**（无 key / 对话太短 / 返回空 / 报错）时，
# 「她开口」这一轮记一次的 connection 缓解量。
# 判定正常时用不到它 —— 那时降幅由判定器 delta 的 connection 分量承担。
# ⚠️ 别为了"降低敏感度"把它调大：它只在失败路径生效，调大只会让失败轮过度归零。
CONNECTION_RELIEF=0.35
# 数值索引（影响阈值触发早晚）
VALENCE_SETPOINT=-0.05
CONNECTION_ACCEL=1.5
ACCEL_DELAY=30

# ── 注入开关 ──
# 是否注入【潮汐基频·此刻】块到用户消息
INJECT_ENABLED=true
# 内容未变化时，N 秒内不重复注入（节流，仿心潮此刻块）
INJECT_THROTTLE_SECONDS=1800

# ── 主动唤醒（proactive）──
# 是否启用阈值触发主动唤醒
PROACTIVE_ENABLED=true
# 唤醒通知投递地址（Operit 工作流回调 / 留空则只写日志）
# 注意：手机侧收不到 VPS 的主动 POST，正常走下面的 MCP 队列由 Operit 来拉。
# 仅当 Operit 确有对外 POST 入口时才填。
PROACTIVE_WEBHOOK=
# 日上限。contact 与 find_activity **共用**同一计数。
# 8 是配合 find_activity 上线后的量级：她整日不出现时实测 contact 4.3 + find 4.3 ≈ 8.6。
PROACTIVE_MAX_PER_DAY=8

# ── 重复抑制（详见 README「十·补」/「十·再补」）──
# 同场景冷却：一个**持续状态**不该每 tick 都报一次。
# find_activity 由"惦记 + 嘴硬"驱动，状态能挂 1~2 小时，而 tick 是 5 分钟一次 ——
# 不开冷却就是 51~110 条/天，日上限瞬间打光、把 contact 一起挤没。0 = 关闭。
# ⚠️ 这个值同时作用于 contact 与 find_activity（共用一个旋钮）。
#    走低情绪通道后实测：60 或 90 分钟 → 冲浪:找你 = 6:2；
#    120 分钟以上 → 掉回 4:4。
ACTION_COOLDOWN_MINUTES=60
# 判定器去重窗口（秒）。工具轮里 Operit 复用同一份 messages 再发一次请求，
# 不按轮次去重就会把同一段对话判 N 次、delta 叠 N 次（实测放大 5.5 倍）。0 = 关闭。
ANALYZE_DEDUP_SECONDS=900

# ── find_activity（独处动作）的两条入口 ──
# 引擎里 find_activity 有两条**互不相干**的触发入口，二选一为主：
#   ① 嘴硬通道：c∈[0.35,0.50) 且 pride≥0.5
#   ② 低情绪通道：valence ≤ VALENCE_ACTIVITY_THRESHOLD 且 immersion<0.3
#      ② 完全不看 connection（vendor/cadence.js:507）
#
# ⚠️ 走 ① 的代价（实测）：她整日不出现时 pride≥0.5 占醒着时间的 **80%**，
#    描述层第 2 段被钉死在同一档、文案不流动。且 c 涨得越快，
#    「找你」(contact) 越容易抢在 pride 顶格之前先触发 → 冲浪反而变少。
#
# ② 是推荐路线：冲浪由「心情低 + 一个人」驱动，pride 交还判定器、恢复流动。

# ① 嘴硬通道的开关。1.0 = 关闭（vendor 哨兵值，永不触发）。
#    只有要走 ① 时才设成 0.20 之类。
PRIDE_DEFEND_THRESHOLD=1.0
# ⚠️ 走 ① 时不要用 vendor 默认的 0.003：在 c∈[0.35,0.50) 的窗口里它只能把
#    pride 涨 0.45，差 0.05 够不到 0.5，find_activity 依然不触发。
# 关闭 ① 时此值无意义。
PRIDE_DEFEND_RATE=0.004

# ② 低情绪通道的阈值。vendor 默认 -1.0 = 永不触发。
# ⚠️ 必须 **≥ VALENCE_SETPOINT** 才会常态成立 —— 两个数在同一个坐标系里，
#    改一个必须回头看另一个。默认 -0.04 比 setpoint(-0.05) 高 0.01。
VALENCE_ACTIVITY_THRESHOLD=-0.04

# 活动缓解（vendor 原生，默认 0=关）：冲浪本身会压低 connection，
# 于是 contact 被自然抑制，「冲浪多于找你」不必再靠 pride 顶格实现。
# ⚠️ vendor 只在**活动类型变化**时才扣（同类型连续冲浪不重复扣），
#    且有 0.01 下限（防止清零导致阈值永不触达）。
# 实测：0 → 冲浪:找你 = 4:4；0.10 → 6:2。
ACTIVITY_CONNECTION_RELIEF=0.10

# ── 自由冲浪（surf）：find_activity 唯一的真实行动 ──
# find_activity 越阈 → 先过静默时段 / 日上限 → 再 spawn 一次 surf 子进程。
# 跑完的结果由 surf 回投 POST /surf/finding，那条路径负责拼块与投递。
SURF_ENABLED=false
SURF_DIR=/root/proactive-web-surf-agent/v2
SURF_ENTRY=dist/index.js
# surf 子进程用哪个 node 跑。⚠️ 不要用「桥自己那个 node」——
# 桥是被 systemd 拉起来的，它的 node 未必是 surf 需要的那个。
SURF_NODE_BIN=/usr/local/bin/node
SURF_TIMEOUT_MS=180000
SURF_FINDING_PATH=/surf/finding
# 活动登记（描述层第 4 段的真来源，见 lib/activity.js）。
# 冲浪子进程 spawn 成功后记一次：type 只用来查引擎的 immersionMap
# （search = 0.4），label 是**唯一会进模型可见文本**的那一项。
# 所以 label 写中文短语、type 写引擎认得的英文枚举，两者别混。
#
# ⚠️ label 写**动作**（他手头在干什么），要与产物头（结果，见 inject-text.js
#    的 FINDING_HEAD「搜到了一条有意思的内容：」）错开维度 —— 撞了就是同义重复。
#    当前这个 label 对应的实体是 VPS 上的 proactive-web-surf-agent（SURF_DIR）。
SURF_ACTIVITY_TYPE=search
SURF_ACTIVITY_LABEL=上网冲浪

# 业务时区偏移（小时），相对 UTC。静默时段与日上限跨天都按这个时区算。
# 服务器系统时区是 UTC，若不设此项，QUIET_START=0/QUIET_END=8 会变成
# 「UTC 0-8 点静默」＝北京时间 8:00-16:00 静默（白天被当成夜里）。
# 北京 = 8，UTC = 0。仅支持整小时偏移。
TZ_OFFSET_HOURS=8

# 静默时段 [start, end)，按上面的业务时区算。左闭右开，支持跨午夜（如 22 → 6）。
QUIET_START=0
QUIET_END=8

# ── MCP 服务（给 Operit 工作流"拉"通知用）──
# 挂在同一端口上，路径 /mcp，Streamable HTTP（JSON-RPC）。
# tick 触发的通知会入队，Operit 定时调 get_pending_notice 取走。
MCP_ENABLED=true
MCP_PATH=/cadence/mcp

